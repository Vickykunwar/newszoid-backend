NODE_ENV=production
PORT=5000
MONGO_URI=
GEMINI_API_KEY=
GROQ_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional private WhatsApp delivery. Leave unset until Twilio WhatsApp,
# approved templates, and verified user opt-in are ready.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_NUMBER=whatsapp:+14155238886
WHATSAPP_ALERT_SECRET=
# Gemini is always attempted before Groq to preserve the resilience order.
AI_STRATEGY=gemini-first
# Optional: comma-separated model names
# GEMINI_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash
# GROQ_MODEL_CANDIDATES=llama-3.3-70b-versatile,llama-3.1-8b-instant
FRONTEND_ORIGINS=https://newszoid.com,https://www.newszoid.com,https://newszoid.vercel.app
SERVE_FRONTEND=false
